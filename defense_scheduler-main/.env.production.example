VITE_USE_MOCK=false
VITE_ENABLE_DEMO_TOOLS=false
VITE_API_BASE_URL=/api
VITE_USE_REMOTE_RULE_CONFIG=true
VITE_USE_REMOTE_CONFLICT_CHECK=true

DJANGO_DEBUG=false
DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
AUTH_TOKEN_TTL_HOURS=12
# Set this only to the address of a reverse proxy you control.
DJANGO_TRUSTED_PROXY=127.0.0.1
# Optional multi-user database/cache (install requirements-production.txt first).
# DJANGO_DB_ENGINE=postgresql
# POSTGRES_DB=defense_scheduler
# POSTGRES_USER=defense_scheduler
# POSTGRES_PASSWORD=replace-with-a-random-database-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REDIS_URL=redis://127.0.0.1:6379/1
